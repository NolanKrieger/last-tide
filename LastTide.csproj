<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>LastTide</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- The sim and its tests are separate projects; don't compile their sources into the game assembly. -->
    <Compile Remove="src/**;tests/**;scratch/**" />
    <ProjectReference Include="src/Sim/Sim.csproj" />
  </ItemGroup>
</Project>
