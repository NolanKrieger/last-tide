; Engine configuration file.

config_version=5

[application]

config/name="Last Tide"
config/description="A roguelite sailing game drawn on a sea chart."
run/main_scene="res://game/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
boot_splash/bg_color=Color(0.933, 0.886, 0.792, 1)
boot_splash/image="res://assets/splash.png"
boot_splash/fullsize=false
config/icon="res://assets/icon.png"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="LastTide"

[physics]

common/physics_ticks_per_second=30

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.933, 0.886, 0.792, 1)

[importer_defaults]

texture={
"mipmaps/generate": true
}
