<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pure C# simulation: no Godot types, so it builds, tests and replays headless. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>LastTide.Sim</RootNamespace>
    <AssemblyName>LastTide.Sim</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Optimized in every configuration: map generation traces a thousand coastlines at voyage start, and the Godot
         editor and `dotnet test` build Debug by default. -->
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Sim.Tests" />
    <InternalsVisibleTo Include="LastTide" />
  </ItemGroup>
</Project>
